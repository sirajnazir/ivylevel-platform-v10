# v15.2 Framework Integration Configuration
# Copy to .env.local and configure as needed

# =============================================================================
# LLM MODEL CONFIGURATION
# =============================================================================

# Intent Routing (Classification)
# Best: gpt-4o (most accurate)
# Budget: gpt-3.5-turbo (10x cheaper)
V15_2_INTENT_MODEL=gpt-4o

# Strategy Producer (Response Generation)
# Best: gpt-4o (most capable)
# Budget: gpt-4-turbo (slightly older)
V15_2_PRODUCER_MODEL=gpt-4o

# Reflection Critic (Quality Evaluation)
# Best: claude-3-5-sonnet-20241022 (most rigorous)
# Budget: claude-3-5-sonnet-20240620 (older version)
V15_2_CRITIC_MODEL=claude-3-5-sonnet-20241022

# Producer Temperature (0.0 = deterministic, 1.0 = creative)
V15_2_PRODUCER_TEMPERATURE=0.7

# Critic Temperature (0.0 = strict, 1.0 = lenient)
V15_2_CRITIC_TEMPERATURE=0

# =============================================================================
# QUALITY GATES CONFIGURATION
# =============================================================================

# Reflection Quality Threshold (0-10 scale)
# Higher = stricter quality requirements
# Production: 7.5, Budget: 6.0
V15_2_QUALITY_THRESHOLD=7.5

# Max Reflection Iterations (1-5)
# Higher = better quality but more expensive
# Production: 3, Budget: 1
V15_2_MAX_ITERATIONS=3

# Intent Confidence Threshold (0.0-1.0)
# Queries below this confidence get routed to clarification
# Production: 0.7, Budget: 0.5
V15_2_INTENT_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# CONTEXT ENGINEERING CONFIGURATION
# =============================================================================

# Few-Shot Examples Count (Pinecone retrieval)
# Higher = more context but more tokens
# Production: 3, Budget: 1
V15_2_FEW_SHOT_COUNT=3

# =============================================================================
# COST OPTIMIZATION (future)
# =============================================================================

# Enable Redis caching for Pinecone results (not yet implemented)
V15_2_ENABLE_CACHING=false

# Enable smart model routing based on query complexity (not yet implemented)
V15_2_ENABLE_SMART_ROUTING=false
