{
  "name": "ivylevel-monorepo",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @apps/api dev",
    "dev:agent": "pnpm --filter @services/agent dev",
    "dev:retriever": "pnpm --filter @services/retriever dev",
    "cron:recompute": "cd cron && npx ts-node recompute.ts",
    "test:ci": "./scripts/ci_evidence_gate.sh",
    "test:smoke": "./scripts/smoke_test.sh",
    "test:golden": "./scripts/run_golden_questions.sh",
    "test:validate": "./scripts/validate_v3.sh",
    "snapshot": "./scripts/golden_snapshot.sh",
    "validate:new-data": "./scripts/validate_new_data.sh",
    "monitor:canary": "./scripts/canary_monitor.sh"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^4.0.0",
    "cohere-ai": "^7.15.1",
    "openai": "^4.104.0",
    "p-limit": "^7.1.1",
    "zod": "^3.23.8"
  }
}
