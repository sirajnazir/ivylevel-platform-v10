# LLM
OPENAI_API_KEY=sk-...
JENNY_MODEL_ID=ft:gpt-4o-mini-2024-07-18:personal:jenny-v1:XXXXX   # Your fine-tuned model ID

# RAG
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=jenny-v1
PINECONE_NAMESPACE=jenny_v1
PINECONE_HOST=https://jenny-v1-<your-host>.svc.<region>.pinecone.io

# Services
RETRIEVER_URL=http://localhost:4102
RETRIEVER_PORT=4102
AGENT_URL=http://localhost:4101
AGENT_PORT=4101
API_PORT=8000

# Eval Configuration
EVAL_BASE_MODEL=gpt-4o-mini-2024-07-18
EVAL_FT_MODEL=${JENNY_MODEL_ID}

# A/B Testing
USE_FT=1  # Set to 0 to use base model

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: Database (for future use)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ivylevel
REDIS_URL=redis://localhost:6379