{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["packages/*/dist"],
      "@services/*": ["services/*/src"],
      "@apps/*": ["apps/*/src"]
    }
  }
}
