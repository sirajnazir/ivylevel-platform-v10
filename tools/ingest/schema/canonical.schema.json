{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalRecord",
  "type": "object",
  "required": ["id", "name", "path", "kind", "text", "meta"],
  "properties": {
    "id":   { "type": "string", "minLength": 3 },
    "name": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["GAMEPLAN","EXEC-RAW","EXEC-INTEL","TRANS-RAW","TRANS-INTEL","IMSG-RAW","IMSG-INTEL","APP-DOC","EMAIL","REPORT","OTHER"]
    },
    "week": { "type": "string", "pattern": "^[0-9]{1,3}$" },
    "phase": { "type": "string", "pattern": "^[1-5]$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "link": { "type": ["string","null"] },
    "text": { "type": "string", "minLength": 5 },
    "segments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["speaker","text"],
        "properties": {
          "speaker": { "type": "string", "enum": ["coach","student","unknown"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["ext","size","folder","lang"],
      "properties": {
        "ext":    { "type": "string" },
        "size":   { "type": "number", "minimum": 1 },
        "folder": { "type": "string" },
        "lang":   { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}