  "services": {
    "proof_verifier": {
      "endpoint": "/api/proof/verify",
      "methods": [
        "POST",
        "GET"
      ],
      "status": "active",
      "features": [
        "SHA-256 hash generation",
        "5-factor proof scoring",
        "Automatic escalation (score < 0.7)",
        "Audit logging",
        "Health metrics"
      ]
    },
