{
  "version": "8.0",
  "name": "Jenny Agentic AI - Human-Grade Digital Twin",
  "created_at": "2025-10-07T00:00:00Z",
  "status": "tagged",
  "vision": "Transform Jenny from a fact-retrieval AI into a human-grade, emotionally intelligent coach that reasons across facts, context, and tone while remaining fully proof-grounded and verifiable.",
  "platform_overview": {
    "fact_layer": {
      "status": "enhanced",
      "description": "Postgres + Readiness Tables + Forecast Features"
    },
    "kb_layer": {
      "status": "enhanced",
      "description": "973 intel chips + auto-linking via semantic graph (edges)"
    },
    "reasoning_layer": {
      "status": "upgraded",
      "description": "Fine-tuned Adapter v2 (ToneCue + TrustCue)"
    },
    "autonomy_layer": {
      "status": "new",
      "description": "Full loop: Diagnose \u2192 Plan \u2192 Act \u2192 Verify \u2192 Learn"
    },
    "governance_layer": {
      "status": "new",
      "description": "Live embedding + tone health dashboards"
    }
  },
  "data_assets": {
    "ToneCue": {
      "source": "iMessage chips",
      "records": 1200,
      "purpose": "Learn warmth + brevity",
      "quality_threshold": 0.9
    },
    "TrustCue": {
      "source": "Session transcripts",
      "records": 800,
      "purpose": "Model EQ and credibility",
      "quality_threshold": 0.9
    },
    "PlanGen": {
      "source": "GamePlan + Assessment",
      "records": 600,
      "purpose": "Multi-step planning logic",
      "quality_threshold": 0.8
    },
    "ProofLink": {
      "source": "Outcome chips",
      "records": 500,
      "purpose": "Map text claims \u2192 evidence IDs",
      "quality_threshold": 0.9
    },
    "total_records": 3100
  },
  "models": {
    "llm_adapter_v2": {
      "base_model": "gpt-4o-mini-2024-07-18",
      "fine_tuned_model": "jenny-4o-tuned-v8",
      "learning_rate": 2e-05,
      "epochs": 3,
      "batch_size": 16,
      "metrics": {
        "tone_similarity": {
          "target": 0.88,
          "description": "Alignment with ToneCue examples"
        },
        "citation_accuracy": {
          "target": 0.98,
          "description": "Correct evidence linking"
        }
      },
      "training_datasets": [
        "ToneCue",
        "TrustCue",
        "PlanGen",
        "ProofLink"
      ]
    },
    "forecast_model_v1": {
      "algorithm": "logistic_regression",
      "version": "1.0",
      "r_squared": 0.72,
      "baseline_r_squared": 0.64,
      "features": {
        "R": {
          "name": "Readiness Score",
          "weight": 2.1
        },
        "S": {
          "name": "SAT/ACT Delta",
          "weight": 0.8
        },
        "E": {
          "name": "Essay Quality",
          "weight": 1.2
        },
        "A": {
          "name": "Award Tier Count",
          "weight": 0.4
        },
        "EC": {
          "name": "EC Depth Score",
          "weight": 0.3
        },
        "REC": {
          "name": "Recommendation Count",
          "weight": 0.2
        }
      },
      "output_categories": [
        "reach",
        "target",
        "likely",
        "safety"
      ],
      "confidence_bands": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "database_schema": {
    "new_tables": [
      {
        "name": "proof_registry",
        "purpose": "Cryptographic verification ledger",
        "indexes": 5
      },
      {
        "name": "proof_audit_log",
        "purpose": "Complete audit trail for verifications",
        "indexes": 2
      },
      {
        "name": "cross_namespace_links",
        "purpose": "Semantic graph edges across KB families",
        "indexes": 3
      },
      {
