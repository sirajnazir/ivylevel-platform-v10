      "endpoint": "/api/forecast",
      "methods": [
        "GET"
      ],
      "status": "active",
      "features": [
        "6-feature logistic regression",
        "Confidence band calculation",
        "Feature importance ranking",
        "Real-time predictions"
      ]
    },
    "agent": {
      "endpoint": "/api/agent/act",
      "methods": [
        "POST"
      ],
      "status": "active",
      "features": [
        "6-stage autonomy loop",
        "Diagnose gaps",
        "Generate plans",
        "Simulate outcomes",
        "Execute actions",
        "Verify results",
        "Learn and adapt"
      ]
    }
  },
  "workers": {
    "selflearn_pipeline": {
      "script": "workers/selflearn.sh",
      "status": "operational",
      "stages": [
        {
          "stage": "classify",
          "worker": "workers/classify_chip.js",
          "model": "gpt-4o-mini",
          "output": "family, phase, tags, chip_type"
        },
        {
          "stage": "enrich",
          "worker": "workers/generate_metadata.js",
          "model": "gpt-4o-mini",
          "output": "edges, key_concepts, provenance"
        },
        {
          "stage": "embed",
          "worker": "workers/embed_upload.js",
          "model": "text-embedding-3-large",
          "dimensions": 3072,
          "output": "vector + dual write (Pinecone + Postgres)"
        }
      ],
      "max_latency_ms": 600000,
      "directories": {
        "ingest": "./ingest/new",
        "processed": "./ingest/processed",
        "errors": "./ingest/errors"
      }
    }
  },
