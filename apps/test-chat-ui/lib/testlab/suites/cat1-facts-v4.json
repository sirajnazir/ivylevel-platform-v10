    {
      "id": "cat1-v4-001",
      "label": "[AWARDS] Initial Targets",
      "category": "facts",
      "prompt": "What awards did I initially plan to apply for?",
      "studentId": "huda-2025",
      "expected": {
        "route": "award.initial",
        "source": "sql",
        "minProof": 0.98,
        "noMetaLeak": true
      }
    },
