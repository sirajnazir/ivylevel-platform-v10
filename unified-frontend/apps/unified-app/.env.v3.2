# ====================================================================
# v3.2 Production Environment Configuration
# ====================================================================
# Purpose: Single environment (production) with v3.2 infrastructure
# Date: 2025-10-23
# Status: PRODUCTION READY
# ====================================================================

ENVIRONMENT=production

# ====================================================================
# API CONFIGURATION (Single Production Environment)
# ====================================================================
VITE_API_BASE_URL=http://localhost:4101/api
VITE_API_TIMEOUT=30000

# Agent Framework Backend (v3.2 Infrastructure)
VITE_AGENT_API_URL=http://localhost:4101/api

# ====================================================================
# v3.2 FEATURE FLAGS (Progressive Rollout)
# ====================================================================

# Week 0-1: Evidence & HGTI Read-Only
VITE_FEATURE_EVIDENCE_PANEL=true
VITE_FEATURE_HGTI_GRAPH=true
VITE_FEATURE_412_UX=true

# Week 2+: EQ Layer (Shadow Mode with Toggle)
VITE_FEATURE_EQ_LAYER=true
VITE_FEATURE_EQ_TOGGLE=true

# Week 3+: Parent Signals (Keep Off Initially)
VITE_FEATURE_PARENT_SIGNALS=false

# Week 2+: IvyScore Version (HGTI Weight)
VITE_IVYSCORE_VERSION=1  # v1=0%, v2=10%, v3=20%, v4=28%

# ====================================================================
# OBSERVABILITY (OpenTelemetry)
# ====================================================================
VITE_OTEL_ENABLED=true
VITE_OTEL_ENDPOINT=http://localhost:4318/v1/traces
VITE_OTEL_SERVICE_NAME=ivylevel-unified-frontend
VITE_OTEL_SAMPLE_RATE=1.0  # 100% sampling during rollout

# ====================================================================
# RLS (Row-Level Security) - Frontend Validation
# ====================================================================
VITE_ENABLE_RLS_CHECKS=true
VITE_RLS_STRICT_MODE=true  # Fail hard on cross-student data leaks

# ====================================================================
# SAFETY GATES
# ====================================================================
VITE_LAB_MODE=false  # NO synthetic data in production UI
VITE_ENABLE_PII_SCRUBBING=true
VITE_ENABLE_ERROR_BOUNDARIES=true

# ====================================================================
# DATABASE (Backend Only - Reference for Context)
# ====================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ivylevel

# ====================================================================
# REDIS (Backend Workers)
# ====================================================================
REDIS_URL=redis://localhost:6379/0

# ====================================================================
# AUTHENTICATION
# ====================================================================
JWT_SECRET_KEY=your-very-secure-secret-key-minimum-32-characters-long-1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====================================================================
# AWS (Legacy - Keep for Document Upload)
# ====================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIATCKAN4ZM725RNVCO
AWS_SECRET_ACCESS_KEY=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
S3_BUCKET_NAME=ivylevel-documents

# ====================================================================
# LEGACY FEATURE FLAGS (Keep for Backwards Compatibility)
# ====================================================================
FEATURE_AI_COACH=true
FEATURE_VIDEO_CALLS=true
FEATURE_DOCUMENT_ANALYSIS=true

# ====================================================================
# PERFORMANCE
# ====================================================================
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL=300000  # 5 minutes
VITE_ENABLE_PREFETCH=true

