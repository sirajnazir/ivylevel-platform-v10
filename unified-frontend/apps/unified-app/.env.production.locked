# ====================================================================
# PRODUCTION ENVIRONMENT - LOCKED CONFIGURATION
# ====================================================================
# Purpose: Immutable production config - DO NOT EDIT WITHOUT APPROVAL
# Last Locked: 2025-10-23
# Version: v3.2.0 - Week 0 (Foundation)
# ====================================================================
# ⚠️  WARNING: This file is read-only in CI/CD
# ⚠️  Changes require: PR approval + deployment sign-off
# ====================================================================

ENVIRONMENT=production
NODE_ENV=production

# ====================================================================
# API CONFIGURATION (LOCKED)
# ====================================================================
VITE_API_BASE_URL=http://localhost:4101/api
VITE_API_TIMEOUT=30000

# ====================================================================
# FEATURE FLAGS - WEEK 0 ROLLOUT (LOCKED)
# ====================================================================

# ✅ ENABLED - Week 0
VITE_FEATURE_EVIDENCE_PANEL=true    # Evidence chips display (read-only)
VITE_FEATURE_HGTI_GRAPH=true        # Growth score display (read-only)
VITE_FEATURE_412_UX=true            # Missing evidence cards

# ❌ DISABLED - Week 0
VITE_FEATURE_EQ_LAYER=false         # Week 2+ (shadow mode server-side only)
VITE_FEATURE_EQ_TOGGLE=false        # Week 2+
VITE_FEATURE_PARENT_SIGNALS=false   # Week 3+

# ====================================================================
# IVYSCORE VERSION (LOCKED)
# ====================================================================
# v1 = 0% HGTI weight (baseline)
# v2 = 10% HGTI weight (Week 2)
# v3 = 20% HGTI weight (Week 3)
# v4 = 28% HGTI weight (Week 5)
VITE_IVYSCORE_VERSION=1

# ====================================================================
# SAFETY GATES (LOCKED - NEVER DISABLE)
# ====================================================================
VITE_LAB_MODE=false                 # NO synthetic data in prod UI
VITE_ENABLE_RLS_CHECKS=true         # Cross-student leak prevention
VITE_RLS_STRICT_MODE=true           # Fail hard on violations
VITE_ENABLE_PII_SCRUBBING=true      # PII redaction in chip source
VITE_ENABLE_ERROR_BOUNDARIES=true   # Error isolation

# ====================================================================
# OBSERVABILITY (LOCKED)
# ====================================================================
VITE_OTEL_ENABLED=true
VITE_OTEL_ENDPOINT=http://localhost:4318/v1/traces
VITE_OTEL_SERVICE_NAME=ivylevel-unified-frontend
VITE_OTEL_SAMPLE_RATE=1.0           # 100% sampling during rollout

# ====================================================================
# 412 UX CONFIGURATION
# ====================================================================
# Only these actions enabled in Week 0:
# - "Add award" → /students/:id/awards/new
# - "Upload transcript" → /students/:id/documents/upload
VITE_412_ENABLED_ACTIONS=add_award,upload_transcript

# ====================================================================
# PERFORMANCE (LOCKED)
# ====================================================================
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL=300000               # 5 minutes
VITE_ENABLE_PREFETCH=true

# ====================================================================
# DATABASE (Backend Only - Reference)
# ====================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ivylevel

# ====================================================================
# REDIS (Backend Workers)
# ====================================================================
REDIS_URL=redis://localhost:6379/0

# ====================================================================
# ROLLOUT METADATA (Documentation)
# ====================================================================
# Current Phase: Week 0 - Foundation (Read-Only Features)
# Next Phase: Week 2 - EQ Shadow Mode (IVYSCORE_VERSION=2)
# Approval Required: Product Lead + Engineering Lead
# ====================================================================
