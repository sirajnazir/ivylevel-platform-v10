{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "emitDeclarationOnly": false,
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["../*/dist"]
    },
    "module": "esnext",
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}